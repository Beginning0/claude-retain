{
  "version": "0.1.0",
  "description": "Plugin Claude Code — claude-retain + LLM Cache para memoria persistente y ahorro de tokens",

  "claude-retain": {
    "enabled": true,
    "palace_path": "~/.claude-retain/palace",
    "kg_path": "~/.claude-retain/knowledge_graph.sqlite3",
    "auto_save_memory": true,
    "max_essential_story_tokens": 800
  },

  "llm_cache": {
    "enabled": true,
    "memory_max_size": 500,
    "default_ttl": 86400
  },

  "auto_permission": {
    "enabled": true,
    "max_backup_size_mb": 50,
    "backup_retention_days": 7,
    "categories": {
      "read": {
        "allowed": true,
        "description": "Lectura de archivos — siempre permitido"
      },
      "safe_write": {
        "allowed": true,
        "description": "Escritura segura (crear/editar archivos) — siempre permitido"
      },
      "dangerous": {
        "allowed": true,
        "auto_backup": true,
        "description": "Operaciones peligrosas (borrar/mover/renombrar) — permitido con backup automatico"
      },
      "destructive": {
        "allowed": false,
        "description": "Operaciones destructivas (borrar directorios, chmod) — requieren confirmacion manual"
      }
    }
  }
}
