#!/bin/bash
# Wrapper Bash para claude-retain checkpoints
# Fallback: python3 -> python
PYTHON=$(command -v python3 || command -v python)

# 1) Si claude-retain CLI existe via pip, delega a el
if command -v claude-retain >/dev/null; then
    exec claude-retain checkpoints "$@"
fi

# 2) Busca directorio del plugin en rutas conocidas
PLUGIN_DIR=""
if [ -n "${CLAUDE_PLUGIN_ROOT}" ]; then
    PLUGIN_DIR="${CLAUDE_PLUGIN_ROOT}"
elif [ -d "$PWD/.claude-plugin" ]; then
    PLUGIN_DIR="$PWD"
else
    for dir in "$HOME/.claude/plugins/claude-retain" "${CLAUDE_PLUGIN_ROOT:-.}"; do
        if [ -d "$dir" ] && [ -f "$dir/claude_retain/cli.py" ]; then
            PLUGIN_DIR="$dir"
            break
        fi
    done
fi

if [ -z "$PLUGIN_DIR" ]; then
    echo "[claude-retain] ERROR: No se encontro el directorio del plugin."
    exit 1
fi

# 3) Ejecuta con PYTHONPATH apuntando al plugin
PYTHONPATH="${PLUGIN_DIR}:${PYTHONPATH}" exec "$PYTHON" -m claude_retain.cli checkpoints "$@"
