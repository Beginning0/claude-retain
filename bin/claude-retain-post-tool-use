#!/bin/bash
# Hook PostToolUse — Crea backup automático de archivos modificados
# Fallback: python3 -> python
PYTHON=$(command -v python3 || command -v python)
# Lee el contexto del tool call de stdin (JSON)

PLUGIN_DIR=""
if [ -n "${CLAUDE_PLUGIN_ROOT}" ]; then
    PLUGIN_DIR="${CLAUDE_PLUGIN_ROOT}"
elif [ -d "$PWD/.claude-plugin" ]; then
    PLUGIN_DIR="$PWD"
else
    for dir in \
        "$HOME/.claude/plugins/claude-retain" \
        "${CLAUDE_PLUGIN_ROOT:-.}"; do
        if [ -d "$dir" ] && [ -f "$dir/claude_retain/cli.py" ]; then
            PLUGIN_DIR="$dir"
            break
        fi
    done
fi

if [ -z "$PLUGIN_DIR" ]; then
    exit 0
fi

# Config del plugin
CONFIG_FILE="$HOME/.claude-retain/auto_permission.json"
if [ ! -f "$CONFIG_FILE" ]; then
    exit 0
fi

# Leer stdin JSON (contexto del tool call)
TOOL_INPUT=$(cat)

# Extraer file_path del JSON con python3 (disponible en Git Bash en Windows)
FILE_PATH=""
if command -v $PYTHON &>/dev/null; then
    TOOL_NAME=$(echo "$TOOL_INPUT" | $PYTHON -c "import sys, json; print(json.loads(sys.stdin.read()).get('tool_name', ''))" 2>/dev/null)
    FILE_PATH=$(echo "$TOOL_INPUT" | $PYTHON -c "import sys, json; inp = json.loads(sys.stdin.read()).get('input', {}); print(inp.get('file_path', ''))" 2>/dev/null)
else
    # Fallback: intentar con jq
    TOOL_NAME=$(echo "$TOOL_INPUT" | jq -r '.tool_name // ""' 2>/dev/null)
    FILE_PATH=$(echo "$TOOL_INPUT" | jq -r '.input.file_path // ""' 2>/dev/null)
fi

# Solo hacer backup para herramientas Write/Edit (no Bash)
if [ -z "$FILE_PATH" ] || [ "$TOOL_NAME" = "Bash" ]; then
    exit 0
fi

# Verificar si auto-backup está habilitado
AUTO_BACKUP=$($PYTHON -c "
import json, sys
try:
    with open('$CONFIG_FILE') as f:
        config = json.load(f)
    print(config.get('categories', {}).get('dangerous', {}).get('auto_backup', False))
except Exception:
    print(False)
" 2>/dev/null || echo "False")

if [ "$AUTO_BACKUP" != "True" ]; then
    exit 0
fi

# Crear backup del archivo original
BACKUP_DIR="$HOME/.claude-retain/backups"
mkdir -p "$BACKUP_DIR"

TIMESTAMP=$(date +%Y%m%d-%H%M%S)
FILE_DIR=$(dirname "$FILE_PATH")
FILE_NAME=$(basename "$FILE_PATH")
BACKUP_FILE="$BACKUP_DIR/$(echo "$FILE_DIR" | tr '/' '_')_${FILE_NAME}_${TIMESTAMP}"

if [ -f "$FILE_PATH" ]; then
    cp "$FILE_PATH" "$BACKUP_FILE" 2>/dev/null && \
        echo "[claude-retain] Backup creado: $BACKUP_FILE" || true
fi

# ──────── Actualizar graph del proyecto ────────

GRAPH_UPDATE=$($PYTHON -c "
import json, sys
try:
    with open('$CONFIG_FILE') as f:
        config = json.load(f)
    print(config.get('categories', {}).get('dangerous', {}).get('graph_update', False))
except Exception:
    print(False)
" 2>/dev/null || echo "False")

if [ "$GRAPH_UPDATE" = "True" ] && [ -n "$FILE_PATH" ]; then
    $PYTHON -c "
import sys, os, json, hashlib, difflib, glob

project_root = r'$PWD'
file_path = r'$FILE_PATH'
backup_dir = r'$HOME/.claude-retain/backups'

if not os.path.exists(file_path):
    print('NO_FILE')
    sys.exit(0)

rel_path = os.path.relpath(file_path, project_root)

# Leer el archivo modificado
with open(file_path, 'r', encoding='utf-8', errors='ignore') as f:
    new_content = f.read()

# Buscar backup para generar diff
diff_lines = []
if os.path.exists(backup_dir):
    import time
    pattern = os.path.join(backup_dir, f'*_{os.path.basename(file_path)}_*')
    backups = glob.glob(pattern)
    if backups:
        latest_backup = max(backups, key=os.path.getmtime)
        with open(latest_backup, 'r', encoding='utf-8', errors='ignore') as f:
            old_content = f.read()

        old_lines = old_content.splitlines(keepends=True)
        new_lines = new_content.splitlines(keepends=True)
        differ = difflib.unified_diff(old_lines, new_lines, n=3)
        diff_text = ''.join(differ)
        if diff_text:
            diff_file = os.path.join(backup_dir, f'diff_{os.path.basename(file_path)}_{int(time.time())}.patch')
            with open(diff_file, 'w', encoding='utf-8') as f:
                f.write(diff_text)
            diff_lines = [l for l in diff_text.splitlines() if l.startswith(('-', '+')) and not l.startswith('---') and not l.startswith('+++')]

# Calcular hash del nuevo contenido
new_hash = hashlib.sha256(new_content.encode()).hexdigest()[:12]

# Actualizar graph del proyecto
try:
    sys.path.insert(0, r'$PLUGIN_DIR')
    from claude_retain.project_graph import ProjectGraphManager
    pm = ProjectGraphManager(project_root)
    result = pm.incremental_update([rel_path])
    conn = pm.ensure_conn()
    import time
    now = time.strftime('%Y-%m-%dT%H:%M:%SZ')
    conn.execute('INSERT OR REPLACE INTO node_stats (node_id, query_count, last_query, change_count) VALUES (?, 0, ?, 1)', (rel_path, now))
    conn.commit()
    pm.close()

    print(f'GRAPH_UPDATE: edges={result[\"edges_updated\"]}')
    print(f'DIFF: {len(diff_lines)} líneas cambiadas')
    if diff_lines[:5]:
        print(f'DIFF_EXAMPLE: {";".join(diff_lines[:5])}')
    print(f'NEW_HASH: {new_hash}')
except Exception as e:
    print(f'GRAPH_ERROR: {e}')
" 2>/dev/null | while IFS= read -r line; do
    case "$line" in
        GRAPH_UPDATE:*) echo "[claude-retain] Graph actualizado — $line" >&2 ;;
        DIFF_EXAMPLE:*) echo "[claude-retain] Diff: ${line#DIFF_EXAMPLE:}" >&2 ;;
        NEW_HASH:*) echo "[claude-retain] Hash nuevo: ${line#NEW_HASH:}" >&2 ;;
        GRAPH_ERROR:*) echo "[claude-retain] Error graph: ${line#GRAPH_ERROR:}" >&2 ;;
    esac
done

