#!/bin/bash
# Wrapper para el servidor MCP del cache LLM (Unix)
# Se asegura de que PYTHONPATH incluya el directorio del plugin

PLUGIN_DIR=""
if [ -n "${CLAUDE_PLUGIN_ROOT}" ]; then
    PLUGIN_DIR="${CLAUDE_PLUGIN_ROOT}"
else
    for dir in \
        "$HOME/.claude/plugins/mempalace" \
        "${CLAUDE_PLUGIN_ROOT:-.}"; do
        if [ -d "$dir" ] && [ -f "$dir/mempalace_plugin/cli.py" ]; then
            PLUGIN_DIR="$dir"
            break
        fi
    done
fi

if [ -z "$PLUGIN_DIR" ]; then
    echo "[mempalace] ERROR: No se encontró el directorio del plugin." >&2
    exit 1
fi

export PYTHONPATH="${PLUGIN_DIR}:${PYTHONPATH}"
export MEMPALACE_CACHE_PATH="$HOME/.mempalace/llm_cache.db"
exec python3 -m mempalace_plugin.mcp_server
