#!/bin/bash
# Wrapper para el servidor MCP del cache LLM (Unix)
# Se asegura de que PYTHONPATH incluya el directorio del plugin

# Fallback: python3 -> python
PYTHON=$(command -v python3 || command -v python)

PLUGIN_DIR=""
if [ -n "${CLAUDE_PLUGIN_ROOT}" ]; then
    PLUGIN_DIR="${CLAUDE_PLUGIN_ROOT}"
else
    for dir in \
        "$HOME/.claude/plugins/claude-retain" \
        "${CLAUDE_PLUGIN_ROOT:-.}"; do
        if [ -d "$dir" ] && [ -f "$dir/claude_retain/cli.py" ]; then
            PLUGIN_DIR="$dir"
            break
        fi
    done
fi

if [ -z "$PLUGIN_DIR" ]; then
    echo "[claude-retain] ERROR: No se encontró el directorio del plugin." >&2
    exit 1
fi

export PYTHONPATH="${PLUGIN_DIR}:${PYTHONPATH}"
export CLAUDE_RETAIN_CACHE_PATH="$HOME/.claude-retain/llm_cache.db"
exec "$PYTHON" -m claude_retain.mcp_server
