#!/bin/bash
# Wrapper para construir/actualizar el graph del proyecto

# Si está instalado via pip, usar CLI directamente
if command -v mempalace &>/dev/null; then
    exec mempalace build-graph "$@"
fi

# Buscar el directorio del plugin en las carpetas conocidas
PLUGIN_DIR=""
if [ -n "${CLAUDE_PLUGIN_ROOT}" ]; then
    PLUGIN_DIR="${CLAUDE_PLUGIN_ROOT}"
elif [ -d "$PWD/.claude-plugin" ]; then
    PLUGIN_DIR="$PWD"
else
    for dir in \
        "$HOME/.claude/plugins/mempalace" \
        "${CLAUDE_PLUGIN_ROOT:-.}"; do
        if [ -d "$dir" ] && [ -f "$dir/mempalace_plugin/cli.py" ]; then
            PLUGIN_DIR="$dir"
            break
        fi
    done
fi

if [ -z "$PLUGIN_DIR" ]; then
    echo "[mempalace] ERROR: No se encontró el directorio del plugin."
    exit 1
fi

# Pasar el resto de los argumentos al CLI
CMD="build-graph"
if [ $# -gt 0 ]; then
    for arg in "$@"; do
        CMD="$CMD $arg"
    done
fi

PYTHONPATH="${PLUGIN_DIR}:${PYTHONPATH}" exec python3 -m mempalace_plugin.cli $CMD
