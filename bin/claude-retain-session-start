#!/bin/bash
# Hook SessionStart — Inicializa el cache LLM al iniciar sesión

PLUGIN_DIR=""
if [ -n "${CLAUDE_PLUGIN_ROOT}" ]; then
    PLUGIN_DIR="${CLAUDE_PLUGIN_ROOT}"
elif [ -d "$PWD/.claude-plugin" ]; then
    PLUGIN_DIR="$PWD"
else
    for dir in \
        "$HOME/.claude/plugins/mempalace" \
        "${CLAUDE_PLUGIN_ROOT:-.}"; do
        if [ -d "$dir" ] && [ -f "$dir/mempalace_plugin/cli.py" ]; then
            PLUGIN_DIR="$dir"
            break
        fi
    done
fi

if [ -z "$PLUGIN_DIR" ]; then
    exit 0
fi

CACHE_PATH="$HOME/.mempalace/llm_cache.db"

# Inicializar la base de datos SQLite del cache si no existe
if [ ! -f "$CACHE_PATH" ]; then
    mkdir -p "$(dirname "$CACHE_PATH")"
    python3 -c "
import sqlite3, os, time
db_path = '$CACHE_PATH'
os.makedirs(os.path.dirname(db_path), exist_ok=True)
conn = sqlite3.connect(db_path)
conn.execute('''CREATE TABLE IF NOT EXISTS llm_cache (
    cache_key TEXT PRIMARY KEY,
    prompt_hash TEXT NOT NULL,
    context_hash TEXT NOT NULL,
    model TEXT NOT NULL,
    provider TEXT NOT NULL,
    pregunta TEXT,
    respuesta TEXT NOT NULL,
    chars_contexto INTEGER DEFAULT 0,
    fecha_guardado TEXT NOT NULL,
    ttl_seconds INTEGER DEFAULT 86400,
    hits INTEGER DEFAULT 0
);''')
conn.commit()
conn.close()
" 2>/dev/null
fi

# Limpiar entradas expiradas del cache
python3 -c "
import sqlite3, time
db_path = '$CACHE_PATH'
if __import__('os').path.exists(db_path):
    conn = sqlite3.connect(db_path)
    now_str = time.strftime('%Y-%m-%d %H:%M:%S')
    conn.execute('DELETE FROM llm_cache WHERE fecha_guardado < ?', (now_str,))
    total = conn.execute('SELECT COUNT(*) FROM llm_cache').fetchone()[0]
    conn.commit()
    print(f'[mempalace] LLM Cache - {total} entradas en cache')
    conn.close()
" 2>/dev/null

# ──────── Detectar nuevo proyecto y construir graph ────────

CURRENT_PROJECT="$PWD"
PROJECT_HASH=$(python3 -c "import hashlib; print(hashlib.md5('$CURRENT_PROJECT'.encode()).hexdigest()[:8])" 2>/dev/null)
GRAPH_DB="$HOME/.mempalace/project_graph_${PROJECT_HASH}.db"

if [ ! -f "$GRAPH_DB" ]; then
    echo "[mempalace] Graph - nuevo proyecto detectado, construyendo graph..." >&2

    python3 -c "
import sys, os
sys.path.insert(0, '$PLUGIN_DIR')
from mempalace_plugin.project_graph import ProjectGraphManager

pm = ProjectGraphManager('$CURRENT_PROJECT')
result = pm.build_graph()
print(f'BUILT: nodes={result[\"nodes_created\"]}, edges={result[\"edges_created\"]}')
" 2>/dev/null || true
fi
