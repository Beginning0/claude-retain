#!/bin/bash
# Wrapper para mostrar estado de las 4 capas de memoria
# Fallback: python3 -> python
PYTHON=$(command -v python3 || command -v python)
if command -v claude-retain &>/dev/null; then
    exec claude-retain layers "$@"
fi

PLUGIN_DIR=""
if [ -n "${CLAUDE_PLUGIN_ROOT}" ]; then
    PLUGIN_DIR="${CLAUDE_PLUGIN_ROOT}"
elif [ -d "$PWD/.claude-plugin" ]; then
    PLUGIN_DIR="$PWD"
else
    for dir in \
        "$HOME/.claude/plugins/claude-retain" \
        "${CLAUDE_PLUGIN_ROOT:-.}"; do
        if [ -d "$dir" ] && [ -f "$dir/claude_retain/cli.py" ]; then
            PLUGIN_DIR="$dir"
            break
        fi
    done
fi

if [ -z "$PLUGIN_DIR" ]; then
    echo "[claude-retain] ERROR: No se encontró el directorio del plugin."
    exit 1
fi

PYTHONPATH="${PLUGIN_DIR}:${PYTHONPATH}" exec "$PYTHON" -m claude_retain.cli layers "$@"
