#!/bin/bash
# Hook Stop — Limpieza al terminar una respuesta (limpiar entradas expiradas del cache)

# Fallback: python3 -> python
PYTHON=$(command -v python3 || command -v python)

PLUGIN_DIR=""
if [ -n "${CLAUDE_PLUGIN_ROOT}" ]; then
    PLUGIN_DIR="${CLAUDE_PLUGIN_ROOT}"
elif [ -d "$PWD/.claude-plugin" ]; then
    PLUGIN_DIR="$PWD"
else
    for dir in \
        "$HOME/.claude/plugins/claude-retain" \
        "${CLAUDE_PLUGIN_ROOT:-.}"; do
        if [ -d "$dir" ] && [ -f "$dir/claude_retain/cli.py" ]; then
            PLUGIN_DIR="$dir"
            break
        fi
    done
fi

if [ -z "$PLUGIN_DIR" ]; then
    exit 0
fi

CACHE_PATH="$HOME/.claude-retain/llm_cache.db"

# Limpiar entradas expiradas del cache al final de cada respuesta
$PYTHON -c "
import sqlite3, time
db_path = '$CACHE_PATH'
if __import__('os').path.exists(db_path):
    conn = sqlite3.connect(db_path)
    now_str = time.strftime('%Y-%m-%d %H:%M:%S')
    deleted = conn.execute('DELETE FROM llm_cache WHERE fecha_guardado < ?', (now_str,))
    total = conn.execute('SELECT COUNT(*) FROM llm_cache').fetchone()[0]
    conn.commit()
    if deleted.rowcount > 0:
        print(f'[claude-retain] LLM Cache - {deleted.rowcount} entradas expiradas eliminadas, {total} restantes')
    conn.close()
" 2>/dev/null
