#!/bin/bash
# Hook LoopUpdate — Evalúa el resultado de una iteración LOOP y actualiza MemPalace

PLUGIN_DIR=""
if [ -n "${CLAUDE_PLUGIN_ROOT}" ]; then
    PLUGIN_DIR="${CLAUDE_PLUGIN_ROOT}"
elif [ -d "$PWD/.claude-plugin" ]; then
    PLUGIN_DIR="$PWD"
else
    for dir in \
        "$HOME/.claude/plugins/mempalace" \
        "${CLAUDE_PLUGIN_ROOT:-.}"; do
        if [ -d "$dir" ] && [ -f "$dir/mempalace_plugin/cli.py" ]; then
            PLUGIN_DIR="$dir"
            break
        fi
    done
fi

if [ -z "$PLUGIN_DIR" ]; then
    exit 0
fi

# Verificar si hay un LOOP activo
LOOP_STATE="$HOME/.claude/loop-task.local.md"
if [ ! -f "$LOOP_STATE" ]; then
    exit 0
fi

# Leer estado actual del LOOP
ITERATION=$(python3 -c "
import sys
try:
    with open('$LOOP_STATE') as f:
        content = f.read()
    for line in content.split('\n'):
        if line.strip().startswith('iteration:'):
            print(line.strip().split(':')[1].strip())
            break
except:
    print('1')
" 2>/dev/null || echo "1")

# Leer el resultado del tool call
TOOL_INPUT=$(cat)
TOOL_NAME=""
RESULT="unknown"

if command -v python3 &>/dev/null; then
    TOOL_NAME=$(echo "$TOOL_INPUT" | python3 -c "import sys, json; print(json.loads(sys.stdin.read()).get('tool_name', ''))" 2>/dev/null)
    EXIT_CODE=$(echo "$TOOL_INPUT" | python3 -c "import sys, json; inp = json.loads(sys.stdin.read()).get('input', {}); print(inp.get('exit_code', ''))" 2>/dev/null)

    if [ -n "$EXIT_CODE" ]; then
        RESULT=$(python3 -c "print('success' if $EXIT_CODE == 0 else 'failure')")
    fi
fi

# Actualizar evaluación en MemPalace
EVAL_DIR="$HOME/.mempalace/evaluations"
if [ ! -d "$EVAL_DIR" ]; then
    mkdir -p "$EVAL_DIR"
fi

TIMESTAMP=$(date +%Y%m%d-%H%M%S)
EVAL_FILE="$EVAL_DIR/loop-${TIMESTAMP}.md"

TASK_NAME=""
if command -v python3 &>/dev/null; then
    TASK_NAME=$(python3 -c "
try:
    with open('$LOOP_STATE') as f:
        content = f.read()
    in_frontmatter = True
    for line in content.split('\n'):
        if in_frontmatter and line.strip() == '---':
            in_frontmatter = False
            continue
        if not in_frontmatter and line.strip():
            print(line.strip())
            break
except:
    print('unknown')
" 2>/dev/null || echo "unknown")
fi

cat > "$EVAL_FILE" <<EOF
---
task: $TASK_NAME
iteration: $ITERATION
mode: loop
tool_used: $TOOL_NAME
result: $RESULT
updated_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)
---
EOF

echo "[mempalace] LoopUpdate - iteracion $ITERATION evaluada: $RESULT"
